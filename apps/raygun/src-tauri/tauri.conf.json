{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raygun",
  "version": "1.9.4",
  "identifier": "app.raygun.player",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Raygun",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#0a0d16"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Raygun",
    "copyright": "Raygun contributors, AGPL-3.0-only",
    "category": "Music",
    "shortDescription": "Music, videos, comics and books in one app",
    "longDescription": "Raygun plays music, podcasts, audiobooks, films and series, and reads comics and books, from your own files and the sources you add.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
