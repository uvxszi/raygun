<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. The window and Android's own start screen are the dark
         background Raygun's start screen (index.html) draws on, so a start goes from one to the
         other without a light flash. -->
    <style name="Theme.raygun" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/raygun_start</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/raygun_start</item>
    </style>
</resources>
