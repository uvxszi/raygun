{
  "id": "tmdb-addon",
  "version": "3.1.7",
  "logo": "https://94c8cb9f702d-tmdb-addon.baby-beamup.club/logo.png",
  "name": "The Movie Database Addon",
  "description": "Stremio addon that provides rich metadata for movies and TV shows from TMDB.",
  "resources": ["catalog", "meta"],
  "types": ["movie", "series"],
  "idPrefixes": ["tmdb:"],
  "catalogs": [
    {
      "id": "tmdb.top",
      "type": "movie",
      "name": "Popular",
      "pageSize": 20,
      "extra": [
        { "name": "genre", "options": ["Action", "Adventure", "Science Fiction"], "isRequired": false },
        { "name": "skip" }
      ]
    },
    {
      "id": "tmdb.year",
      "type": "series",
      "name": "Year",
      "pageSize": 20,
      "extra": [{ "name": "genre", "options": ["2026", "2025"], "isRequired": false }, { "name": "skip" }]
    },
    { "id": "tmdb.search", "type": "movie", "name": "Search", "extra": [{ "name": "search", "isRequired": true, "options": [] }] },
    { "id": "tmdb.top", "type": "movie", "name": "Popular again" }
  ],
  "behaviorHints": { "configurable": true, "configurationRequired": false }
}
