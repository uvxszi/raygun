{
  "id": "dev.raygun.radio-browser",
  "name": "Radio Browser",
  "version": "1.0.1",
  "apiVersion": 1,
  "runtime": "js",
  "entry": "dist/index.js",
  "description": "Live internet radio from the community-run radio-browser.info station directory.",
  "author": "Raygun",
  "provides": ["music.metadata"],
  "permissions": { "net": ["*.api.radio-browser.info"] },
  "contentRating": "safe",
  "settings": [
    {
      "key": "order",
      "type": "select",
      "label": "Sort stations by",
      "options": ["popularity", "votes", "name"],
      "default": "popularity"
    },
    {
      "key": "country",
      "type": "text",
      "label": "Only stations from (country code, e.g. DE)",
      "default": ""
    }
  ]
}
