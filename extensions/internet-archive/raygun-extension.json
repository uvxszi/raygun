{
  "id": "dev.raygun.internet-archive",
  "name": "Internet Archive",
  "version": "1.1.0",
  "apiVersion": 1,
  "runtime": "js",
  "entry": "dist/index.js",
  "description": "Public-domain and Creative Commons audio from the Internet Archive.",
