{
  "id": "dev.raygun.internet-archive",
  "name": "Internet Archive",
  "version": "1.3.0",
  "apiVersion": 1,
  "runtime": "js",
  "entry": "dist/index.js",
  "description": "Public-domain and Creative Commons audio and films from the Internet Archive.",
  "author": "Raygun",
  "provides": ["music.metadata", "music.stream", "video.source"],
  "permissions": { "net": ["archive.org", "*.archive.org"] },
  "contentRating": "safe",
  "settings": [
    {
      "key": "itemsPerSearch",
      "type": "number",
      "default": 6
    }
  ]
}
