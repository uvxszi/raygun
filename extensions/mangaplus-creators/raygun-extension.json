{
  "id": "dev.raygun.mangaplus-creators",
  "name": "MANGA Plus Creators",
  "version": "1.0.0",
  "apiVersion": 1,
  "runtime": "js",
  "entry": "dist/index.js",
  "description": "Manga that creators post themselves on Shueisha's MANGA Plus Creators, free to read, in English or Spanish.",
  "author": "Raygun",
  "website": "https://mangaplus-creators.jp",
  "provides": ["manga.source"],
  "permissions": {
    "net": ["mangaplus-creators.jp"]
  },
  "contentRating": "suggestive",
  "settings": [
    {
      "key": "language",
      "type": "select",
      "label": "Language",
      "options": ["English", "Spanish"],
      "default": "English"
    }
  ]
}
