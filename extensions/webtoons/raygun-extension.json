{
  "id": "dev.raygun.webtoons",
  "name": "WEBTOON",
  "version": "1.0.0",
  "apiVersion": 1,
  "runtime": "js",
  "entry": "dist/index.js",
  "description": "Free episodes from WEBTOON: the publisher's Originals and its Canvas of creators' own series, in seven languages, with rankings, genres and search.",
  "author": "Raygun",
  "website": "https://www.webtoons.com",
  "provides": ["manga.source"],
  "permissions": {
    "net": ["www.webtoons.com", "m.webtoons.com"]
  },
  "contentRating": "suggestive",
  "settings": [
    {
      "key": "language",
      "type": "select",
      "label": "Language",
      "options": [
        "English",
        "Spanish",
        "French",
        "German",
        "Indonesian",
        "Thai",
        "Chinese (Traditional)"
      ],
      "default": "English"
    }
  ]
}
