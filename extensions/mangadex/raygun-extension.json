{
  "id": "dev.raygun.mangadex",
  "name": "MangaDex",
  "version": "1.3.0",
  "apiVersion": 1,
  "runtime": "js",
  "entry": "dist/index.js",
  "description": "Manga from MangaDex, the scanlation library run by its community. Covers and pages load through Raygun.",
  "author": "Raygun",
  "website": "https://mangadex.org",
  "provides": ["manga.source"],
  "permissions": {
    "net": ["api.mangadex.org"]
  },
  "contentRating": "suggestive",
  "settings": [
    {
      "key": "language",
      "type": "select",
      "label": "Chapter language",
      "options": [
        "English",
        "Spanish (Latin America)",
        "Spanish (Spain)",
        "Portuguese (Brazil)",
        "Portuguese (Portugal)",
        "French",
        "German",
        "Italian",
        "Russian",
        "Ukrainian",
        "Polish",
        "Czech",
        "Hungarian",
        "Romanian",
        "Turkish",
        "Arabic",
        "Persian",
        "Hebrew",
        "Indonesian",
        "Malay",
        "Filipino",
        "Vietnamese",
        "Thai",
        "Japanese",
        "Korean",
        "Chinese (Simplified)",
        "Chinese (Traditional)"
      ],
      "default": "English"
    },
    {
      "key": "contentRating",
      "type": "select",
      "label": "Content shown",
      "options": ["Safe", "Safe and suggestive", "Everything"],
      "default": "Safe and suggestive"
    },
    {
      "key": "dataSaver",
      "type": "boolean",
      "label": "Data saver (smaller page images)",
      "default": false
    }
  ]
}
