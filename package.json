{
  "name": "raygun",
  "version": "1.9.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "python tools/trim_target.py && pnpm --filter @raygun/app tauri dev",
    "android:init": "pnpm --filter @raygun/app tauri android init",
    "android:dev": "python tools/trim_target.py && pnpm --filter @raygun/app tauri android dev",
    "android:build": "pnpm --filter @raygun/app tauri android build",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bindings": "cargo run -p raygun-app --bin export-bindings",
    "build:extensions": "pnpm --filter \"./extensions/*\" build",
    "raygun-ext": "node packages/sdk/bin/raygun-ext.mjs",
    "repo:publish": "node packages/sdk/bin/raygun-ext.mjs pack-all extensions --repo repo",
    "i18n:import": "node scripts/i18n-import.mjs",
    "trim:target": "python tools/trim_target.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
