# Raygun for Arch Linux and Arch-based systems (CachyOS, EndeavourOS, Manjaro), from the release's
# deb. The release workflow builds it for every release (.github/workflows/release.yml, job `arch`)
# and attaches the packages. For another version by hand: set _ver, run `updpkgsums`, `makepkg -si`.
pkgname=raygun-bin
_ver=1.9.6
pkgver=${_ver//-/_}
pkgrel=1
pkgdesc='Music, videos, comics and books in one app'
arch=('x86_64' 'aarch64')
url='https://github.com/uvxszi/raygun'
license=('AGPL-3.0-only')
depends=('webkit2gtk-4.1' 'gtk3' 'gst-plugins-base' 'gst-plugins-good' 'gst-libav' 'hicolor-icon-theme')
optdepends=('gst-plugins-bad: more streaming formats')
provides=('raygun')
conflicts=('raygun')
options=('!strip' '!debug')
source_x86_64=("Raygun_${_ver}_amd64.deb::${url}/releases/download/v${_ver}/Raygun_${_ver}_amd64.deb")
source_aarch64=("Raygun_${_ver}_arm64.deb::${url}/releases/download/v${_ver}/Raygun_${_ver}_arm64.deb")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  bsdtar -xf "${srcdir}/data.tar.gz" -C "${pkgdir}"
  chmod -R u=rwX,go=rX "${pkgdir}/usr"
}
