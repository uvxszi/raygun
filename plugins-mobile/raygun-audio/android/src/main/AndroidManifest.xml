<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Downloads keep running in the background, shown in their own notifications. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Settings → Permissions: Android's question about running in the background. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Hearing other Raygun devices' mDNS for Connect (M46.15). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Scanning another device's link QR code (M46.47); phones without a camera still install. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- M46.18: whether the phone is on mobile data (the Audio quality setting for it) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The reverb (M46.12) is an effect on the output mix. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Installing Raygun's own updates from its GitHub releases (M46.47). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Reading the device's music library (M07). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Playing videos from folders added to Local Files (M46.27). -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Local Files' folders of pictures, read as comics (M46.51). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Optional, asked only from Local Files and Settings → Permissions (M46.51): other apps'
         books and comic archives (EPUB, CBZ, ZIP) in shared storage, which MediaStore doesn't
         list, read by path. Raygun isn't distributed through Google Play. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Saving files to Downloads and Pictures on Android 9 and older (M46.1); newer versions use MediaStore. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Android 10 reads shared storage by path only in legacy mode (Local Files, the device's
         music); later versions ignore the flag. -->
    <application android:requestLegacyExternalStorage="true">
        <!-- The video player (M38): landscape, resizable for picture-in-picture. -->
        <activity
            android:name="app.raygun.audio.VideoPlayerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <!-- The built-in browser for websites the user added (M46.3), in its own process so its
             cookies, storage and cache stay apart from Raygun's webview. -->
        <activity
            android:name="app.raygun.audio.WebsiteActivity"
            android:process=":web"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <!-- A visible browser for passing a source's browser check by hand (experimental), in its
             own process with its own WebView data. -->
        <activity
            android:name="app.raygun.audio.BrowserCheckActivity"
            android:process=":check"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity
            android:name="app.raygun.audio.WebsiteDataActivity"
            android:process=":web"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <service
            android:name="app.raygun.audio.RaygunDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Play on TV: Raygun keeps serving the stream while a TV plays it. -->
        <service
            android:name="app.raygun.audio.CastKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <receiver
            android:name="app.raygun.audio.DownloadActionReceiver"
            android:exported="false" />
        <service
            android:name="app.raygun.audio.RaygunPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
